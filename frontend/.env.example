# Data source on first load: "false" = the VeriMetrix backend (default), "true" = built-in demo data.
# Can also be switched at runtime from the Settings page.
VITE_USE_MOCK=false

# Backend base URL. Leave empty to use the Vite dev proxy (below) — avoids CORS during development.
VITE_API_BASE_URL=

# Where the dev server proxies /api and /uploads when VITE_API_BASE_URL is empty.
VITE_PROXY_TARGET=http://localhost:8080
